{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:app.notion.com)",
      "WebFetch(domain:www.notion.so)",
      "WebFetch(domain:www.refarmkobe.com)",
      "WebFetch(domain:www.city.kobe.lg.jp)",
      "WebFetch(domain:web.pref.hyogo.lg.jp)",
      "WebFetch(domain:www.maff.go.jp)",
      "Bash(npx @marp-team/marp-cli *)",
      "Bash(npx @mermaid-js/mermaid-cli *)",
      "Bash(python tools/generate_image.py)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git pull)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
